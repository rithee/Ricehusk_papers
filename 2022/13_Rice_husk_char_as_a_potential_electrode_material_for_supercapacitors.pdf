      <dc:title>
        <rdf:Alt>
          <rdf:li lang="x-default">{Rice husk char as a potential electrode material for supercapacitors:}</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:relation>
        <rdf:Bag>
          <rdf:li>bibtex/number/3</rdf:li>
          <rdf:li>bibtex/file/:C\:/Users/User/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Naga et al. - 2022 - Rice husk char as a potential electrode material for supercapacitors.pdf:pdf;:www/jESE_V12_No3_451-462.pdf:PDF</rdf:li>
