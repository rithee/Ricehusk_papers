        <rdf:Seq>
          <rdf:li>Venkata Naga</rdf:li>
          <rdf:li>Kanaka Suresh</rdf:li>
          <rdf:li>Kumar Nersu</rdf:li>
          <rdf:li>Bhujanga Rao Annepu</rdf:li>
          <rdf:li>Satya Srinivasa</rdf:li>
